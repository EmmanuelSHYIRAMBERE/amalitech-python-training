# Copy this file to .env and fill in your values.
# Never commit .env to version control.

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=urlshortener
DB_USER=postgres
DB_PASSWORD=your-db-password-here
# Docker: DB_HOST=db, DB_PORT=5432
# Local:  DB_HOST=localhost, DB_PORT=5435
DB_HOST=db
DB_PORT=5432
# External port exposed on the host machine (maps to container port 5432)
DB_EXTERNAL_PORT=5435

# Module 8: Redis
# Docker: REDIS_URL=redis://redis:6379/0
# Local:  REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Module 8: Celery Broker (uses Redis database 1, separate from cache)
# Docker: CELERY_BROKER_URL=redis://redis:6379/1
# Local:  CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://redis:6379/1

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Gunicorn
WEB_CONCURRENCY=2
WEB_CMD=sh -c "python manage.py migrate --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 2"

# Celery
CELERY_WORKER_CMD=celery -A config worker -Q default,maintenance --concurrency 2 --loglevel info
CELERY_BEAT_CMD=celery -A config beat --loglevel info --scheduler django_celery_beat.schedulers:DatabaseScheduler
