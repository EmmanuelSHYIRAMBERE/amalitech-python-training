AMALI_API_KEY=your_amali_key_here
AMALI_BASE_URL=https://ai-api.amalitech.org/api/v2/public/
PRIMARY_PROVIDER=openai
FALLBACK_PROVIDER=anthropic
OPENAI_MODEL=gpt-3.5-turbo
ANTHROPIC_MODEL=claude-haiku-4-5
REDIS_URL=redis://localhost:6379
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_SECONDS=3600
RELEVANCE_THRESHOLD=0.05
MAX_HISTORY_MESSAGES=10
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DB_PATH=./chroma_db

# Docker Compose — ports and commands (override these in .env to customise)
API_PORT=8000
REDIS_EXTERNAL_PORT=6379
API_CMD=sh -c "python scripts/seed.py && uvicorn app.main:app --host 0.0.0.0 --port 8000"
