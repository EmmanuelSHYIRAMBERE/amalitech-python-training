# Copy this file to .env and fill in your values.
# Never commit .env to version control.

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=urlpreview
DB_USER=postgres
DB_PASSWORD=your-db-password-here
# Docker: DB_HOST=db, DB_PORT=5432
# Local:  DB_HOST=localhost, DB_PORT=5436
DB_HOST=db
DB_PORT=5432

# Redis (circuit breaker state + response cache)
# Docker: REDIS_URL=redis://redis:6379/0
# Local:  REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed caller origins
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limiting (requests per day per API key)
API_KEY_RATE_LIMIT=1000
