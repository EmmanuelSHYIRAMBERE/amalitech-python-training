PORT=3000
NODE_ENV=development
AWS_REGION=eu-north-1

# S3 + CloudFront
PHOTOS_BUCKET=emmanuel-photo-uploader-photos
CLOUDFRONT_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net

# Database — for local dev, set DB_PASSWORD directly.
# In ECS, DB_SECRET_ARN is set instead and the password is fetched from
# Secrets Manager at startup (see src/db/pool.ts).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=photouploader
DB_USER=photoapp
DB_PASSWORD=
DB_SECRET_ARN=
