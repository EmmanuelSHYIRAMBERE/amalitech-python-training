# Django
SECRET_KEY=change-me-to-a-real-random-value
DEBUG=false
ALLOWED_HOSTS=*

# AWS
AWS_REGION=eu-north-1

# Database (local dev -- no DB_SECRET_ARN, so no SSL, uses DB_PASSWORD directly)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=photouploader
DB_USER=photoapp
DB_PASSWORD=photoapp

# Database (production/ECS -- set DB_SECRET_ARN instead of DB_PASSWORD;
# password is fetched from Secrets Manager and SSL is forced)
# DB_SECRET_ARN=arn:aws:secretsmanager:eu-north-1:...:secret:...

# S3 / CloudFront
PHOTOS_BUCKET=
CLOUDFRONT_DOMAIN=
